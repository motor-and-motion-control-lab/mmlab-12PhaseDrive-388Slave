# 防止在盖油过孔上出现丝印
#(rule silk_over_via
#   (constraint silk_clearance (min 0.2mm))
#   (condition "A.Type == '*Text' && B.Type == 'Via'")
#)

# 走线与焊盘之间的间距
(rule "Pad to Track Clearance"
    (constraint clearance (min 0.2mm) (opt 0.3mm) (max 0.56mm))
    (condition "A.Type == 'Pad' && B.Type == 'Track'")
)



# 走线与走线之间的间距

(rule "Track to Track Clearance"
    (constraint clearance (min 9mil) (opt 0.56mm) (max 0.56mm))
    (condition "A.Type == 'Track' && B.Type == 'Track'")
)

# 走线与via之间的间距

(rule "Track to Via Clearance"
    (constraint clearance (min 0.30mm) (opt 0.56mm) (max 0.56mm))
    (condition "A.Type == 'Via' && B.Type == 'Track'")
)





# 表层AGND到其他网络间距
(rule clearance
(condition "A.NetName=='GND'")
(condition "A.Type=='Zone'")
(layer outer)
(constraint clearance (min 0.35mm) (opt 0.5mm))
)

(rule clearance
(condition "A.NetName=='GND'")
(condition "A.Type=='Zone'")
(layer inner)
(constraint clearance (min 0.35mm) (opt 0.5mm))
)







# 允许连接器的丝印与板边相交1
(rule silk_board_edge_clearance1
    (constraint silk_clearance)
    (severity ignore)
    (condition "A.memberOfFootprint('DSUB*') && B.Layer=='Edge.Cuts'"))

# 允许连接器的丝印与板边相交2
(rule silk_board_edge_clearance2
    (constraint silk_clearance)
    (severity ignore)
    (condition "A.memberOfFootprint('Q46') && B.Layer=='Edge.Cuts'"))













# 其他网络到PE间距
(rule clearance
(condition "A.NetName=='PE_GND'")
(constraint clearance (min 0.7mm) (opt 1.5mm))
)


# 其他网络到PE间距
(rule clearance
(condition "A.NetName=='PE_GND'&& B.memberOfFootprint('ref*')")
(constraint clearance (min 0.1mm) (opt 0.1mm))
)
